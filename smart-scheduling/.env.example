# Copy to .env (git-ignored) and fill in. Never commit real values.
# Tests use a separate, git-ignored .env.test (see tests/README.md).
# Production values come from the hosting platform's secret store, not a file
# (see DEPLOYMENT.md).

# --- Database ---------------------------------------------------------------
# docker-compose.yml (local dev database) refuses to start without this.
# Generate a random value, e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=<generate-a-random-password>
# Local container: same password as above. Managed PostgreSQL: add
# ?sslmode=verify-full (see DEPLOYMENT.md).
DATABASE_URL=postgres://postgres:<same-password-as-POSTGRES_PASSWORD>@localhost:5432/smart_db

# --- Auth.js (Google OAuth) -------------------------------------------------
# Required. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=<generate-a-random-secret>
# Public origin of the app, no path. Pins the OAuth callback origin and is what
# enables trustHost in production, so it is REQUIRED there (https://).
# NEXTAUTH_SECRET is still read as a fallback for AUTH_SECRET; NEXTAUTH_URL is
# read for the origin but does NOT enable trustHost, so use AUTH_URL.
# Google redirect URI to register: <AUTH_URL>/api/auth/callback/google
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# --- Microsoft Entra ID (optional: only for "Sync from Entra ID") -------------
# An app registration with the Microsoft Graph APPLICATION permission
# User.Read.All (admin consent granted), plus Group.Read.All and
# GroupMember.Read.All if you map Entra security groups to app groups. Without these, the sync button is
# disabled and says what is missing. Never commit the secret.
#ENTRA_TENANT_ID=<directory-tenant-id>
#ENTRA_CLIENT_ID=<app-registration-client-id>
#ENTRA_CLIENT_SECRET=<app-registration-client-secret>
# A complete sync deactivates employees linked to a directory account that is
# gone or disabled. If more than this many people, or more than this percentage
# of the linked active employees, would be deactivated in one run, nobody is
# (the run records why). Defaults: 25 and 10.
#ENTRA_SYNC_MAX_DEACTIVATIONS=25
#ENTRA_SYNC_MAX_DEACTIVATION_PERCENT=10

# --- Online Teams meetings (optional: the "Online Teams Meeting" checkbox) ------
# A DEDICATED Entra app registration (not the directory-sync one, not Google)
# with the Microsoft Graph APPLICATION permission Calendars.ReadWrite, limited
# to the organizer mailbox below (see DEPLOYMENT.md section 9a). Every Teams
# meeting is created in that one mailbox, without attendees; the application's
# own e-mails carry the joining link. Without all four values the checkbox is
# not shown and bookings work exactly as before. Never commit the secret.
#TEAMS_TENANT_ID=<directory-tenant-id>
#TEAMS_CLIENT_ID=<teams-app-registration-client-id>
#TEAMS_CLIENT_SECRET=<teams-app-registration-client-secret>
#TEAMS_ORGANIZER_EMAIL=<licensed-mailbox@your-company.example>
# Teams meetings are created in the background; the booking e-mails wait for
# the joining link at most this many minutes, then go out without it (the link
# follows in an update). Default 15.
#ONLINE_INVITE_MAX_WAIT_MINUTES=15

# --- Dashboard reports ---------------------------------------------------------
# Most bookings one report download may contain; a larger selection is refused
# with a message asking for a shorter period or narrower filters. Default 5000.
#REPORT_MAX_ROWS=5000

# --- E-mail (one sender, one SMTP relay for ALL booking e-mail) ---------------
# Official sender for every message (new booking, recurring series, update,
# cancellation, reminder). Required: nothing is sent without it. One address,
# e.g. "Meeting Rooms <rooms@your-company.example>".
EMAIL_FROM="Meeting Rooms <rooms@your-company.example>"
# The organisation's approved SMTP relay. Required.
SMTP_HOST=<smtp-relay-host>
# 587 = STARTTLS (TLS is mandatory: the send fails rather than downgrade),
# 465 = implicit TLS.
SMTP_PORT=587
# Optional: "true" = implicit TLS, "false" = STARTTLS. Unset: 465 -> implicit,
# anything else -> STARTTLS.
#SMTP_SECURE=
# Only if the relay requires authentication (both or neither).
# (Older .env files used EMAIL_USER / EMAIL_PASSWORD: those names are NOT read.)
#SMTP_USER=
#SMTP_PASSWORD=
# DEVELOPMENT ONLY: allow a local relay/sink without TLS (e.g. MailHog on
# localhost). Refused for a non-local host when NODE_ENV=production.
#SMTP_ALLOW_INSECURE=true

# --- Optional -----------------------------------------------------------------
# Only behind a reverse proxy that OVERWRITES X-Forwarded-Host and sets (or
# appends to) X-Forwarded-For. Used for the origin check only when AUTH_URL is
# not set, and for the per-IP limit of the public invitation-answer endpoint.
#TRUST_PROXY_HEADERS=true
# Set to false on extra replicas so only one instance runs the reminder job.
#REMINDER_CRON_ENABLED=true
#REMINDER_LEAD_MINUTES=15
# Enables /api/notifications/email for server-to-server calls; unset = disabled.
#INTERNAL_API_SECRET=
