{
  "name": "smart-scheduling",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --import ./tests/setup.ts --test \"tests/unit/**/*.test.ts\"",
    "test:db": "node --import tsx --import ./tests/setup.ts --test --test-concurrency=1 \"tests/db/**/*.test.ts\"",
    "test:e2e": "node --import tsx --import ./tests/setup.ts --test --test-concurrency=1 \"tests/e2e/**/*.test.ts\"",
    "test": "npm run test:unit && npm run test:db",
    "test:all": "npm run test:unit && npm run test:db && npm run test:e2e",
    "build:test": "node tests/helpers/next-with-test-env.mjs build"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ics": "^3.12.0",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "node-cron": "^4.5.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.21.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.79.0",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
